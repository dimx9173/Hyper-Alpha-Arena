# Hyper Alpha Arena - Environment Configuration

# =================================================================
# Hyperliquid Trading Configuration
# =================================================================

# Encryption key for private key storage (REQUIRED for Hyperliquid trading)
# Generate with: python utils/encryption.py
# Keep this secret! If lost, you cannot decrypt stored private keys.
HYPERLIQUID_ENCRYPTION_KEY=your-encryption-key-here

# Hyperliquid environment defaults
# These can be overridden per account in the database
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MIN_ORDER_VALUE=10.0
HYPERLIQUID_MAX_POSITION_VALUE_PER_ORDER=1000.0

# =================================================================
# API Configuration (existing)
# =================================================================

# Add your other environment variables below...

# =================================================================
# JEV Pre-trade Gate Configuration
# =================================================================
# JEV_GATE_MODE: "jes" (true SystemOne, requires JEV_API_KEY from console.typesafe.ai)
#                "llm" (fallback: uses standard OpenAI-compatible endpoint)
# JEV_API_KEY: for JES mode, get from https://console.typesafe.ai
#              for LLM mode, any non-empty string enables the gate
# JEV_BASE_URL: for JES mode: https://api.typesafe.ai/v1
#               for LLM mode: your OpenAI-compatible gateway (e.g. http://100.77.223.42:8415/v1)
# JEV_MODEL: for JES mode: jev-latest
#            for LLM mode: your model name (e.g. auto-free)
# JEV_TIMEOUT_SECONDS: HTTP timeout (default 8)
# JEV_MIN_CONFIDENCE: gate confidence threshold 0.0-1.0 (default 0.55)
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_GATE_MODE=jes
JEV_TIMEOUT_SECONDS=8
JEV_MIN_CONFIDENCE=0.55